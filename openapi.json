{
  "openapi": "3.0.3",
  "info": {
    "title": "Dropicgram API",
    "description": "REST API for Dropicgram — a social photo-sharing platform. Auth is via JWT in the `Authorization: Bearer <token>` header (or a `token` cookie). All endpoints return JSON.",
    "version": "1.0.0",
    "contact": { "name": "Dropicgram" }
  },
  "servers": [
    { "url": "https://aware-economy-cellular-philadelphia.trycloudflare.com", "description": "Live backend" },
    { "url": "http://localhost:4000", "description": "Local dev" }
  ],
  "tags": [
    { "name": "auth", "description": "Authentication and session" },
    { "name": "posts", "description": "Posts, comments, likes, reactions, polls, reposts" },
    { "name": "users", "description": "User profiles and follows" },
    { "name": "account", "description": "Account settings and profile editing" },
    { "name": "search", "description": "Search, hashtags, trends, lists" },
    { "name": "notifications", "description": "Notifications" },
    { "name": "messages", "description": "Direct messages" },
    { "name": "stories", "description": "24h stories" },
    { "name": "misc", "description": "Bookmarks, blocks, mutes, drafts, reports, stats, export" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "display_name": { "type": "string" },
          "bio": { "type": "string" },
          "avatar": { "type": "string", "nullable": true },
          "cover": { "type": "string", "nullable": true },
          "is_verified": { "type": "integer", "enum": [0, 1] },
          "is_private": { "type": "integer", "enum": [0, 1] },
          "created_at": { "type": "string" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "token": { "type": "string", "description": "JWT — store it and send as Authorization: Bearer" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "body": { "type": "string" },
          "image": { "type": "string", "nullable": true, "description": "Path to a .pqos image" },
          "created_at": { "type": "string" },
          "username": { "type": "string" },
          "display_name": { "type": "string" },
          "likes_count": { "type": "integer" },
          "comments_count": { "type": "integer" },
          "reposts_count": { "type": "integer" },
          "liked_by_me": { "type": "boolean" },
          "bookmarked": { "type": "boolean" },
          "pinned": { "type": "integer", "enum": [0, 1] },
          "is_owner": { "type": "boolean" },
          "poll": { "type": "object", "nullable": true },
          "reactions": { "type": "array", "items": { "type": "object" } },
          "comments": { "type": "array", "items": { "type": "object" } }
        }
      },
      "PostResponse": {
        "type": "object",
        "properties": { "post": { "$ref": "#/components/schemas/Post" } }
      },
      "PostsResponse": {
        "type": "object",
        "properties": { "posts": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } } }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Register a new account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "minLength": 3, "maxLength": 20, "pattern": "^[a-zA-Z0-9_]+$" }, "display_name": { "type": "string" }, "password": { "type": "string", "minLength": 6 } } } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "409": { "description": "Username taken" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Log in",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/auth/logout": {
      "post": { "tags": ["auth"], "summary": "Log out", "responses": { "200": { "description": "OK" } } }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Get the current user",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "user": { "$ref": "#/components/schemas/User" } } } } } }, "401": { "description": "Not logged in" } }
      }
    },
    "/api/posts": {
      "post": {
        "tags": ["posts"],
        "summary": "Create a post (text, image, or both)",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "body": { "type": "string" }, "image": { "type": "string", "format": "binary" }, "poll_question": { "type": "string", "description": "JSON: {\"question\":\"...\",\"options\":[\"a\",\"b\"]}" } } } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } }, "400": { "description": "Empty post or image conversion failed" }, "409": { "description": "Duplicate image" } }
      }
    },
    "/api/posts/feed": {
      "get": {
        "tags": ["posts"],
        "summary": "Feed of posts from people you follow + your own",
        "parameters": [
          { "name": "before", "in": "query", "schema": { "type": "string" }, "description": "Pagination cursor (created_at)" },
          { "name": "media", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "Only posts with images" }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostsResponse" } } } } }
      }
    },
    "/api/posts/explore": {
      "get": { "tags": ["posts"], "summary": "All posts, newest first", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostsResponse" } } } } } }
    },
    "/api/posts/user/{username}": {
      "get": {
        "tags": ["posts"],
        "summary": "A user's profile + posts",
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/posts/{id}": {
      "get": { "tags": ["posts"], "summary": "Get a single post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } }, "404": { "description": "Not found" } } },
      "put": { "tags": ["posts"], "summary": "Edit own post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "body": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK" }, "403": { "description": "Not your post" } } },
      "delete": { "tags": ["posts"], "summary": "Delete own post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" }, "403": { "description": "Not your post" } } }
    },
    "/api/posts/{id}/like": {
      "post": { "tags": ["posts"], "summary": "Like a post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } } } }
    },
    "/api/posts/{id}/unlike": {
      "post": { "tags": ["posts"], "summary": "Unlike a post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/posts/{id}/react": {
      "post": { "tags": ["posts"], "summary": "Add an emoji reaction", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "emoji": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/posts/{id}/repost": {
      "post": { "tags": ["posts"], "summary": "Repost a post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Created" } } }
    },
    "/api/posts/{id}/quote": {
      "post": { "tags": ["posts"], "summary": "Quote a post with your own text", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "body": { "type": "string" } } } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/api/posts/{id}/pin": {
      "post": { "tags": ["posts"], "summary": "Pin/unpin own post", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/posts/{id}/comments": {
      "post": { "tags": ["posts"], "summary": "Comment or reply (optionally with an image)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "body": { "type": "string" }, "parent_id": { "type": "integer", "description": "Set to reply to a comment" }, "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/posts/polls/{pollId}/vote": {
      "post": { "tags": ["posts"], "summary": "Vote on a poll", "parameters": [{ "name": "pollId", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "option_id": { "type": "integer" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/{username}": {
      "get": { "tags": ["users"], "summary": "Get a user profile with counts", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } } }
    },
    "/api/users/{username}/follow": {
      "post": { "tags": ["users"], "summary": "Follow a user (or request to follow if private)", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "requested": { "type": "boolean" } } } } } } } }
    },
    "/api/users/{username}/unfollow": {
      "post": { "tags": ["users"], "summary": "Unfollow a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/requests/{username}/accept": {
      "post": { "tags": ["users"], "summary": "Accept a follow request", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/requests/{username}/decline": {
      "post": { "tags": ["users"], "summary": "Decline a follow request", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/settings": {
      "get": { "tags": ["account"], "summary": "Get notification/dark-mode settings", "responses": { "200": { "description": "OK" } } },
      "put": { "tags": ["account"], "summary": "Update settings", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "dark_mode": { "type": "integer", "enum": [0, 1] }, "notif_likes": { "type": "integer", "enum": [0, 1] }, "notif_comments": { "type": "integer", "enum": [0, 1] }, "notif_follows": { "type": "integer", "enum": [0, 1] }, "notif_mentions": { "type": "integer", "enum": [0, 1] }, "notif_messages": { "type": "integer", "enum": [0, 1] } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/profile": {
      "put": { "tags": ["account"], "summary": "Edit display name + bio", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "display_name": { "type": "string" }, "bio": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/avatar": {
      "put": { "tags": ["account"], "summary": "Upload avatar image", "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/cover": {
      "put": { "tags": ["account"], "summary": "Upload cover image", "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/password": {
      "put": { "tags": ["account"], "summary": "Change password", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "current": { "type": "string" }, "next": { "type": "string", "minLength": 6 } } } } } }, "responses": { "200": { "description": "OK" }, "401": { "description": "Wrong current password" } } }
    },
    "/api/account/privacy": {
      "put": { "tags": ["account"], "summary": "Toggle private account", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "is_private": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/account/account": {
      "delete": { "tags": ["account"], "summary": "Permanently delete account", "responses": { "200": { "description": "OK" } } }
    },
    "/api/search": {
      "get": { "tags": ["search"], "summary": "Search users, posts, and hashtags", "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/hashtag/{tag}": {
      "get": { "tags": ["search"], "summary": "Posts with a hashtag", "parameters": [{ "name": "tag", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/trending": {
      "get": { "tags": ["search"], "summary": "Trending hashtags by usage", "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/suggestions": {
      "get": { "tags": ["search"], "summary": "Suggested users to follow", "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/followers/{username}": {
      "get": { "tags": ["search"], "summary": "Followers of a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/following/{username}": {
      "get": { "tags": ["search"], "summary": "Users a person follows", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/search/requests": {
      "get": { "tags": ["search"], "summary": "Pending follow requests for you", "responses": { "200": { "description": "OK" } } }
    },
    "/api/notifications": {
      "get": { "tags": ["notifications"], "summary": "List notifications + unread count", "responses": { "200": { "description": "OK" } } }
    },
    "/api/notifications/unread": {
      "get": { "tags": ["notifications"], "summary": "Unread notification count", "responses": { "200": { "description": "OK" } } }
    },
    "/api/notifications/read-all": {
      "post": { "tags": ["notifications"], "summary": "Mark all notifications read", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/conversations": {
      "get": { "tags": ["messages"], "summary": "List DM conversations", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/{username}": {
      "get": { "tags": ["messages"], "summary": "Message thread with a user (marks read)", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["messages"], "summary": "Send a message (text or photo)", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "body": { "type": "string" }, "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "201": { "description": "Sent" } } }
    },
    "/api/stories": {
      "get": { "tags": ["stories"], "summary": "Stories from you + people you follow (24h)", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["stories"], "summary": "Post a story image", "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/api/stories/{id}/view": {
      "post": { "tags": ["stories"], "summary": "Mark a story viewed", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/bookmarks": {
      "get": { "tags": ["misc"], "summary": "Saved posts", "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/bookmarks/{postId}": {
      "post": { "tags": ["misc"], "summary": "Save a post", "parameters": [{ "name": "postId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["misc"], "summary": "Unsave a post", "parameters": [{ "name": "postId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/blocks": {
      "get": { "tags": ["misc"], "summary": "Blocked users", "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/blocks/{username}": {
      "post": { "tags": ["misc"], "summary": "Block a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["misc"], "summary": "Unblock a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/mutes": {
      "get": { "tags": ["misc"], "summary": "Muted users", "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/mutes/{username}": {
      "post": { "tags": ["misc"], "summary": "Mute a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["misc"], "summary": "Unmute a user", "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/muted-words": {
      "get": { "tags": ["misc"], "summary": "Muted words", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["misc"], "summary": "Add a muted word", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "word": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["misc"], "summary": "Remove a muted word", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "word": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/drafts": {
      "get": { "tags": ["misc"], "summary": "List drafts", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["misc"], "summary": "Save a draft", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "body": { "type": "string" } } } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/api/misc/drafts/{id}": {
      "delete": { "tags": ["misc"], "summary": "Delete a draft", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/reports": {
      "post": { "tags": ["misc"], "summary": "Report content", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "target_type": { "type": "string", "enum": ["post", "user", "comment"] }, "target_id": { "type": "integer" }, "reason": { "type": "string" } } } } } }, "responses": { "201": { "description": "Reported" } } }
    },
    "/api/misc/stats": {
      "get": { "tags": ["misc"], "summary": "Your account stats", "responses": { "200": { "description": "OK" } } }
    },
    "/api/misc/export": {
      "get": { "tags": ["misc"], "summary": "Download your data as JSON", "responses": { "200": { "description": "JSON file download" } } }
    },
    "/ws": {
      "get": {
        "tags": ["misc"],
        "summary": "WebSocket endpoint for real-time events (DMs, notifications, typing, read receipts)",
        "description": "Connect with the auth token as a query param: /ws?token=<JWT>. Events: dm, notification, typing, read, new_post, connected.",
        "responses": { "101": { "description": "Switching Protocols" } }
      }
    }
  }
}
